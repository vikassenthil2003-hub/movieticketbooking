# ========================================================
# CineVerse AI - Frontend Environment Configuration Example (Create React App)
# ========================================================

# Production build destination (dist for Vercel/Render compatibility)
BUILD_PATH=dist
PORT=3000

# In production (e.g. Vercel), set REACT_APP_API_URL to your deployed Render backend:
# REACT_APP_API_URL=https://your-backend.onrender.com
# In local development, leave empty or set to http://localhost:5000:
REACT_APP_API_URL=http://localhost:5000

# WebSocket / Socket.IO Server URL (Defaults to REACT_APP_API_URL origin or http://localhost:5000)
REACT_APP_SOCKET_URL=http://localhost:5000

# Backward compatibility with existing deployment environments
VITE_API_URL=http://localhost:5000
VITE_SOCKET_URL=http://localhost:5000

# Optional demo email helpers for login page
REACT_APP_DEMO_CUSTOMER_EMAIL=customer@example.com
REACT_APP_DEMO_ADMIN_EMAIL=admin@example.com
REACT_APP_DEMO_THEATRE_EMAIL=theatre@example.com
VITE_DEMO_CUSTOMER_EMAIL=customer@example.com
VITE_DEMO_ADMIN_EMAIL=admin@example.com
VITE_DEMO_THEATRE_EMAIL=theatre@example.com
