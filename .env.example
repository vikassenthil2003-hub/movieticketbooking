# ========================================================
# CineVerse AI - Frontend Environment Configuration Example
# ========================================================

# In production (e.g. Vercel), set VITE_API_URL to your deployed Render backend:
# VITE_API_URL=https://your-backend.onrender.com
# In local development, leave empty or set to http://localhost:5000:
VITE_API_URL=http://localhost:5000

# WebSocket / Socket.IO Server URL (Defaults to VITE_API_URL origin or http://localhost:5000)
VITE_SOCKET_URL=http://localhost:5000

# Optional demo email helpers for login page
VITE_DEMO_CUSTOMER_EMAIL=customer@example.com
VITE_DEMO_ADMIN_EMAIL=admin@example.com
VITE_DEMO_THEATRE_EMAIL=theatre@example.com

