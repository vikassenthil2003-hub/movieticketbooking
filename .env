# CineVerse AI Frontend Configuration
# In production (e.g. Vercel), set VITE_API_URL to your deployed Render backend (e.g. https://cineverse-backend.onrender.com)
# In local development, http://localhost:5000 is used as fallback
VITE_API_URL=http://localhost:5000
VITE_SOCKET_URL=http://localhost:5000

# Optional development email helpers (no privileged passwords stored in frontend)
VITE_DEMO_CUSTOMER_EMAIL=customer@cineverse.com
VITE_DEMO_ADMIN_EMAIL=admin@cineverse.com
VITE_DEMO_THEATRE_EMAIL=theatre@cineverse.com
